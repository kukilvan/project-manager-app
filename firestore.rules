rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }

    // Shared pool (point types, devices, cables, works): everyone reads, only the pool admin writes
    function poolAdmin() { return signedIn() && request.auth.token.email == 'erudit199867@gmail.com'; }
    // List of allowed e-mails (members of your projects): only the admin writes; a person can read their own entry.
    // Only they may create projects and write to the shared collections, so a stranger with any Google account cannot clutter anything.
    match /allowed/{email} {
      allow read: if signedIn() && (poolAdmin() || request.auth.token.email.lower() == email);
      allow write: if poolAdmin();
    }
    function allowed() { return poolAdmin() || (signedIn() && exists(/databases/$(database)/documents/allowed/$(request.auth.token.email.lower()))); }
    match /pool_types/{id} { allow read: if signedIn(); allow write: if poolAdmin(); }
    match /pool_devices/{id} { allow read: if signedIn(); allow write: if poolAdmin(); }
    match /pool_cables/{id} { allow read: if signedIn(); allow write: if poolAdmin(); }
    match /pool_catalog/{id} { allow read: if signedIn(); allow write: if poolAdmin(); }
    // Manuals (diagrams, photos, PDFs): the file record is shared, everyone reads and adds; the file itself lives on the author's Drive
    match /pool_manuals/{id} { allow read: if signedIn(); allow write: if allowed(); }
    // Door configurations: any member records a new kind; only the pool admin deletes (marks deleted)
    match /pool_doorcfg/{id} {
      allow read: if signedIn();
      allow create, update: if poolAdmin() || (allowed() && request.resource.data.get('deleted', false) == false);
      allow delete: if poolAdmin();
    }
    // Shared delay reasons, culprits and problems: any member adds and edits; only the pool admin deletes (marks deleted)
    match /pool_delayReasons/{id} { allow read: if signedIn(); allow create, update: if poolAdmin() || (allowed() && request.resource.data.get('deleted', false) == false); allow delete: if poolAdmin(); }
    match /pool_culprits/{id} { allow read: if signedIn(); allow create, update: if poolAdmin() || (allowed() && request.resource.data.get('deleted', false) == false); allow delete: if poolAdmin(); }
    match /pool_problems/{id} { allow read: if signedIn(); allow create, update: if poolAdmin() || (allowed() && request.resource.data.get('deleted', false) == false); allow delete: if poolAdmin(); }
    // Pool inbox: each user's app sends new and changed items; only the admin reads and decides
    match /pool_inbox/{id} {
      allow read, delete: if poolAdmin();
      allow create: if allowed();
      allow update: if poolAdmin() || (allowed()
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status', 'seenHash', 'seenItem', 'seenAt']));
    }

    // Personal data and the sync test: the owner only
    match /users/{uid}/{document=**} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // Projects: only members see and change them (the memberUids list in the project document).
    // Points, days, entries and so on live inside the project as subcollections.
    match /projects/{projectId} {
      allow create: if allowed() && request.auth.uid in request.resource.data.memberUids;
      // An invited person (by Google e-mail) sees the project and joins or declines on their own
      allow read: if signedIn() && (request.auth.uid in resource.data.memberUids
        || request.auth.token.email in resource.data.get('invitedEmails', []));
      allow update: if signedIn() && (
        // a member changes the project; the member list and invitations are changed only by the project's creator
        (request.auth.uid in resource.data.memberUids
          && (request.auth.uid == resource.data.get('createdBy', request.auth.uid)
              || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['memberUids', 'memberEmails', 'invitedEmails', 'removedMembers', 'createdBy', 'archived', 'deleted'])))
        || (request.auth.token.email in resource.data.get('invitedEmails', [])
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(
                 ['memberUids', 'memberEmails', 'invitedEmails', 'updatedAt', 'updatedBy', 'updatedByName', 'updatedAtServer'])
            && (
              // accept: add only yourself
              (request.resource.data.memberUids.size() == resource.data.memberUids.size() + 1
                && request.auth.uid in request.resource.data.memberUids
                && request.resource.data.memberUids.hasAll(resource.data.memberUids))
              // decline: the member list does not change
              || request.resource.data.memberUids == resource.data.memberUids)));
      allow delete: if false; // only «soft» deletion (a flag in the document)

      match /{sub}/{docId=**} {
        allow read: if signedIn() &&
          request.auth.uid in get(/databases/$(database)/documents/projects/$(projectId)).data.memberUids;
        // getAfter: a project and its reference lists can be created in one batch
        allow write: if signedIn() &&
          request.auth.uid in getAfter(/databases/$(database)/documents/projects/$(projectId)).data.memberUids;
      }
    }
  }
}
